<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    
    <!-- Python WSGI 애플리케이션 핸들러 -->
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    
    <!-- Gunicorn WSGI 서버 실행 설정 -->
    <!-- python -m gunicorn 명령으로 Gunicorn 시작 (포트 8000) -->
    <httpPlatform processPath="%PYTHON_EXE%"
                  arguments="-m gunicorn --bind=0.0.0.0:8000 --workers=2 --worker-class=gthread --threads=2 --timeout=60 run:app"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\home\LogFiles\python.log"
                  stderrLogEnabled="true"
                  stderrLogFile="D:\home\LogFiles\python_error.log"
                  startupTimeLimit="90">
    </httpPlatform>

    <!-- 응답 헤더 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Powered-By" value="Flask/Gunicorn" />
      </customHeaders>
    </httpProtocol>

    <!-- 정적 파일 캐싱 -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
