<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    
    <!-- httpPlatformHandler: 포트 8000에서 실행되는 Gunicorn으로 라우트 -->
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\home\site\wwwroot\.venv\Scripts\gunicorn.exe"
                  arguments="--bind=0.0.0.0:8000 --workers=4 --threads=2 --worker-class=gthread --timeout=60 --access-logfile - --error-logfile - run:app"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\home\LogFiles\python.log"
                  startupTimeLimit="60">
    </httpPlatform>

    <!-- 정적 파일 캐싱 -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- 응답 헤더 설정 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Powered-By" value="Flask" />
      </customHeaders>
    </httpProtocol>

    <!-- 리크라이트 규칙: 정적 파일만 제외 -->
    <rewrite>
      <rules>
        <rule name="DenyDebugLog" stopProcessing="true">
          <match url="debug\.log" />
          <action type="Deny" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!-- 환경 설정 -->
  <appSettings>
    <add key="PYTHONPATH" value="D:\home\site\wwwroot" />
  </appSettings>
</configuration>
